# ==============================================================
# Facebook RSS Bot - Environment Configuration
# ==============================================================

# --------------------------------------------------------------
# Residential Proxy (CRITICAL for 24/7 server / GitHub Actions)
# --------------------------------------------------------------
# Format:
#   http://username:password@host:port
#   socks5://username:password@host:port
#
# Examples with popular residential proxy providers:
#   FB_PROXY_URL=http://user123:pass456@geo.iproyal.com:12321
#   FB_PROXY_URL=http://customer-xyz:pwd@pr.brightdata.com:22225
#   FB_PROXY_URL=http://user:pass@pr.oxylabs.io:7777
#   FB_PROXY_URL=socks5://user:pass@127.0.0.1:1080
FB_PROXY_URL=

# --------------------------------------------------------------
# Gemini API Keys (Event Extraction LLM)
# --------------------------------------------------------------
# Single key or comma-separated pool:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --------------------------------------------------------------
# Admin & Session Security
# --------------------------------------------------------------
ADMIN_TOKEN=
SESSION_SECRET=

# --------------------------------------------------------------
# Email Inbox Privacy, Auth & CORS
# --------------------------------------------------------------
INGEST_API_KEY=
STORE_EMAIL_CONTENT=false
CORS_ORIGINS=

# --------------------------------------------------------------
# Ngrok Live Demo Tunnel (Optional)
# --------------------------------------------------------------
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
